<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/myra_dark" android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingTop="40dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SETTINGS" android:textColor="@color/myra_red"
            android:textSize="20sp" android:textStyle="bold" android:letterSpacing="0.3"
            android:layout_marginBottom="24dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Gemini API Key" android:textColor="@color/myra_text" android:textSize="13sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/apiKeyInput" android:layout_width="match_parent" android:layout_height="48dp"
            android:inputType="textPassword" android:background="@drawable/bg_input_field"
            android:textColor="@color/myra_text" android:padding="12dp" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Your Name" android:textColor="@color/myra_text" android:textSize="13sp" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/nameInput" android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_input_field" android:textColor="@color/myra_text"
            android:padding="12dp" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="AI Model" android:textColor="@color/myra_text" android:textSize="13sp" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/modelSpinner" android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_input_field" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Voice" android:textColor="@color/myra_text" android:textSize="13sp" android:layout_marginBottom="4dp"/>
        <Spinner android:id="@+id/voiceSpinner" android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/bg_input_field" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Personality" android:textColor="@color/myra_text" android:textSize="13sp" android:layout_marginBottom="8dp"/>
        <RadioGroup android:id="@+id/personalityGroup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
            <RadioButton android:id="@+id/radioGf" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="GF 💖" android:textColor="@color/myra_text" android:checked="true"/>
            <RadioButton android:id="@+id/radioProfessional" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Pro 💼" android:textColor="@color/myra_text"/>
            <RadioButton android:id="@+id/radioAssistant" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Assistant 🤖" android:textColor="@color/myra_text"/>
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Prime Contacts" android:textColor="@color/myra_text" android:textSize="13sp" android:layout_marginBottom="8dp"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/primeRecycler"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/addPrimeButton" android:layout_width="match_parent" android:layout_height="44dp"
            android:text="+ ADD PRIME CONTACT" android:textColor="@color/myra_red"
            android:background="@drawable/bg_input_field" android:layout_marginBottom="16dp"/>

        <TextView android:id="@+id/accessibilityStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Accessibility: Checking..."
            android:textColor="@color/myra_hint" android:textSize="13sp" android:padding="12dp"
            android:background="@drawable/bg_input_field" android:layout_marginBottom="24dp"/>

        <Button android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="52dp"
            android:text="SAVE SETTINGS" android:textColor="@color/myra_text"
            android:background="@drawable/bg_save_button" android:layout_marginBottom="32dp"/>
    </LinearLayout>
</ScrollView>
