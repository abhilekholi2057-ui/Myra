<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="end" android:padding="4dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_chat_user"
        android:padding="10dp" android:maxWidth="260dp">
        <TextView android:id="@+id/chatText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/myra_text" android:textSize="13sp"/>
        <TextView android:id="@+id/chatTime" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/myra_hint"
            android:textSize="9sp" android:layout_gravity="end"/>
    </LinearLayout>
</LinearLayout>
